{{- .Stat.Permissions | printf "\033[1;34m%s\033[0m " -}} {{/* Cyan bold for all perms */}}
{{- .Stat.User | printf "\033[1;32m%s\033[0m " -}}       {{/* Green for user */}}
{{- .Stat.Group | printf "\033[1;33m%s\033[0m " -}}      {{/* Yellow for group */}}
{{- .Stat.Size | humanize | printf "\033[1;31m%6s\033[0m " -}}
{{- .Stat.ModTime | printf "%s " -}}
{{- .Stat.Name | printf "| \033[1;36m%ss\033[0m" -}}   
