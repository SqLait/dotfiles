# Status bar position
# set-option -g status-position bottom

# Split window bindings with current path
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"

##
# Bar styling
##

RED="#ea6962"
GREEN="#a9b665"
YELLOW="#d8a657"
BLUE="#7daea3"
MAGENTA="#d3869b"
CYAN="#89b482"
BLACK="#1d2021"
DARK_GRAY="#32302F"
LIGHT_GRAY="#4F4946"
BG="#32302F"
FG="#d4be98"

set -g renumber-windows on

set -g window-status-format " #I "
set -g window-status-current-format " #I "

# Basic colors of the Statusbar
set -g status-style bg=${BG},fg=${FG}
set -g status-left "#[fg=${MAGENTA}]#S #[fg=${FG}]│ "
set -g status-right "#[fg=back,bright]\
#[fg=${RED}]#{b:pane_current_path}\
#[fg=${FG}]@#[fg=${GREEN}]#H #[fg=${CYAN},dim]%H:%M"

set -g window-status-bell-style "bg=red,nobold"
set -g window-status-current-style \
    "#{?window_zoomed_flag,bg=${CYAN},bg=${MAGENTA}}"

##
# Pane separator
##

set -g pane-border-line simple
set -g pane-border-style fg=${BG},bright
#set -g pane-active-border-style fg=${FG}
