set disassembly-flavor intel
set print pretty on
set style emoji off

source ~/.config/gdb/tree-tui.py
tui new-layout tree tree 1 src 1 cmd 1
tui new-layout asm+ asm 1 regs 1 cmd 1
alias -a dasm = disassemble

# ========file styling===========#
set style line-number foreground green
set style line-number intensity normal
# ======end file styling=========#

python
print("\n===============================================================")
print("'Everything is open source when you know assembly'")
print("================================================================\n")
end
