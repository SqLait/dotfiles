#!/bin/dash

WALLPAPER_CONFIG_FILE="$HOME/.config/hypr/last_wallpaper"

# Initialize awww
awww-daemon --format argb

# Check if the configuration file exists
if [ -f "$WALLPAPER_CONFIG_FILE" ]; then
  WALLPAPER_PATH=$(cat "$WALLPAPER_CONFIG_FILE")

  # Set the wallpaper using awww
  awww img "$WALLPAPER_PATH"
fi

